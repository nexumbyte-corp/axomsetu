# Node Environment (development | production | test)
NODE_ENV=production
TZ=Asia/Kolkata

# Application Port
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:secure_password@localhost:5432/school_saas?schema=public&connection_limit=20"

# JWT Authentication Secrets (Must be random, cryptographically secure strings minimum 32 characters)
JWT_ACCESS_SECRET=generate_strong_random_access_secret_32_chars_min
JWT_REFRESH_SECRET=generate_strong_random_refresh_secret_32_chars_min

# Token Expiration Durations
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Server-Side Session Security Configuration
SESSION_MAX_AGE_DAYS=7
SESSION_SECRET=generate_strong_random_session_cookie_secret_key

# Allowed Frontend Origins (Comma-separated for multi-domain support)
CLIENT_URL=http://localhost:5173,https://yourdomain.com

# Reverse Proxy Trust (Set to true or 1 when running behind Nginx, Cloudflare, AWS ALB)
TRUST_PROXY=true

# Serve Client Build Files from Server (Set to true or 1 if serving client dist directly from express)
SERVE_CLIENT=false

# System Automated Backup Configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Command to execute for offsite Cloud S3 / Cloudflare R2 / Rclone / SCP upload:
# REMOTE_BACKUP_COMMAND="aws s3 cp {file} s3://your-offsite-backup-bucket/axomsetu-backups/"
REMOTE_BACKUP_COMMAND=""

# Initial Super Admin Seed Credentials
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@schoolsaas.com"
SEED_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword123!"

# Cloud Storage Configuration (Optional for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
