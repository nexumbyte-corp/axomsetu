// ==========================================
// STAFF & PAYROLL
// ==========================================

model Staff {
  id            String      @id @default(uuid()) @db.Uuid
  schoolId      String      @map("school_id") @db.Uuid
  employeeId    String      @map("employee_id")
  name          String
  email         String?
  phone         String?
  role          StaffRole   @default(TEACHER)
  department    String?
  designation   String?
  joiningDate   DateTime?   @map("joining_date") @db.Date
  status        StaffStatus @default(ACTIVE)

  baseSalary    Decimal     @default(0) @map("base_salary") @db.Decimal(12, 2)
  bankName      String?     @map("bank_name")
  bankAccountNo String?     @map("bank_account_no")
  ifscCode      String?     @map("ifsc_code")

  advanceBalance Decimal    @default(0) @map("advance_balance") @db.Decimal(12, 2)

  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  advances        StaffAdvance[]
  salaryPayments  SalaryPayment[]
  salarySetups    StaffSalarySetup[]
  monthlyPayrolls MonthlyPayroll[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@map("staff")
}

model StaffAdvance {
  id          String      @id @default(uuid()) @db.Uuid
  schoolId    String      @map("school_id") @db.Uuid
  staffId     String      @map("staff_id") @db.Uuid
  amount      Decimal     @db.Decimal(12, 2)
  recovered   Decimal     @default(0) @db.Decimal(12, 2)
  advanceDate DateTime    @map("advance_date") @db.Date
  paymentMode PaymentMode @map("payment_mode")
  referenceNo String?     @map("reference_no")
  remarks     String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([staffId])
  @@map("staff_advances")
}

model StaffSalarySetup {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  staffId        String       @map("staff_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  effectiveFrom  DateTime     @default(now()) @map("effective_from") @db.Date
  baseSalary     Decimal      @db.Decimal(12, 2)
  components     Json?        @map("components")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, staffId, academicYearId])
  @@index([schoolId])
  @@index([staffId])
  @@index([academicYearId])
  @@map("staff_salary_setups")
}

model MonthlyPayroll {
  id                  String        @id @default(uuid()) @db.Uuid
  schoolId            String        @map("school_id") @db.Uuid
  staffId             String        @map("staff_id") @db.Uuid
  academicYearId      String        @map("academic_year_id") @db.Uuid
  month               FeeMonth
  year                Int
  workingDays         Int           @default(26) @map("working_days")
  workedDays          Int           @default(26) @map("worked_days")
  paidLeave           Int           @default(0) @map("paid_leave")
  unpaidLeave         Int           @default(0) @map("unpaid_leave")

  baseSalary          Decimal       @map("base_salary") @db.Decimal(12, 2)
  attendanceDeduction Decimal       @default(0) @map("attendance_deduction") @db.Decimal(12, 2)
  bonus               Decimal       @default(0) @map("bonus") @db.Decimal(12, 2)
  advanceDeduction    Decimal       @default(0) @map("advance_deduction") @db.Decimal(12, 2)
  otherDeduction      Decimal       @default(0) @map("other_deduction") @db.Decimal(12, 2)
  netSalary           Decimal       @map("net_salary") @db.Decimal(12, 2)
  paidAmount          Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)

  status              ChargeStatus  @default(UNPAID)
  remarks             String?
  preparedById        String?       @map("prepared_by_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff        Staff                     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  academicYear AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  allocations  SalaryPaymentAllocation[]

  @@unique([schoolId, staffId, academicYearId, month, year])
  @@index([schoolId])
  @@index([staffId])
  @@index([academicYearId])
  @@index([schoolId, staffId, month, year])
  @@index([schoolId, status])
  @@map("monthly_payrolls")
}

model SalaryPayment {
  id              String        @id @default(uuid()) @db.Uuid
  schoolId        String        @map("school_id") @db.Uuid
  staffId         String        @map("staff_id") @db.Uuid
  academicYearId  String?       @map("academic_year_id") @db.Uuid
  paymentNumber   String        @map("payment_number")
  paymentDate     DateTime      @map("payment_date") @db.Timestamptz

  months          FeeMonth[]
  year            Int

  baseSalary      Decimal       @map("base_salary") @db.Decimal(12, 2)
  allowances      Decimal       @default(0) @db.Decimal(12, 2)
  deductions      Decimal       @default(0) @db.Decimal(12, 2)
  advanceDeducted Decimal       @default(0) @map("advance_deducted") @db.Decimal(12, 2)
  netSalary       Decimal       @map("net_salary") @db.Decimal(12, 2)

  paymentMode     PaymentMode   @map("payment_mode")
  referenceNo     String?       @map("reference_no")
  remarks         String?
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff        Staff                     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  academicYear AcademicYear?             @relation(fields: [academicYearId], references: [id])
  createdBy    User?                     @relation("SalaryPaymentCreatedBy", fields: [createdById], references: [id])
  allocations  SalaryPaymentAllocation[]

  @@unique([schoolId, paymentNumber])
  @@index([schoolId])
  @@index([staffId])
  @@map("salary_payments")
}

model SalaryPaymentAllocation {
  id               String         @id @default(uuid()) @db.Uuid
  salaryPaymentId  String         @map("salary_payment_id") @db.Uuid
  monthlyPayrollId String         @map("monthly_payroll_id") @db.Uuid
  allocatedAmount  Decimal        @map("allocated_amount") @db.Decimal(12, 2)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  salaryPayment  SalaryPayment  @relation(fields: [salaryPaymentId], references: [id], onDelete: Cascade)
  monthlyPayroll MonthlyPayroll @relation(fields: [monthlyPayrollId], references: [id], onDelete: Cascade)

  @@index([salaryPaymentId])
  @@index([monthlyPayrollId])
  @@map("salary_payment_allocations")
}

// ==========================================
// SUBSCRIPTION SYSTEM
// ==========================================

enum PlanType {
  TRIAL
  MONTHLY
  QUARTERLY
  YEARLY
}

enum DurationUnit {
  DAY
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
}

enum SubscriptionPaymentMethod {
  CASH
  UPI
  OTHER
  RAZORPAY
}

enum SubscriptionPaymentProvider {
  MANUAL
  RAZORPAY
}

model SubscriptionPlan {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  code               String       @unique
  type               PlanType
  durationValue      Int          @map("duration_value")
  durationUnit       DurationUnit @default(MONTH) @map("duration_unit")
  basePrice          Decimal      @map("base_price") @db.Decimal(12, 2)
  discountPercentage Decimal      @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  discountAmount     Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalPrice         Decimal      @map("final_price") @db.Decimal(12, 2)
  currency           String       @default("INR")
  description        String?
  features           Json
  offerTitle         String?      @map("offer_title")
  offerDescription   String?      @map("offer_description")
  badge              String?
  isTrial            Boolean      @default(false) @map("is_trial")
  isActive           Boolean      @default(true) @map("is_active")
  displayOrder       Int          @default(0) @map("display_order")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions SchoolSubscription[]
  payments      SubscriptionPayment[]

  @@map("subscription_plans")
}

model SchoolSubscription {
  id                 String                    @id @default(uuid()) @db.Uuid
  schoolId           String                    @map("school_id") @db.Uuid
  planId             String?                   @map("plan_id") @db.Uuid
  planNameSnapshot   String                    @map("plan_name_snapshot")
  durationSnapshot   String                    @map("duration_snapshot")
  basePriceSnapshot  Decimal                   @map("base_price_snapshot") @db.Decimal(12, 2)
  discountSnapshot   Decimal                   @default(0) @map("discount_snapshot") @db.Decimal(12, 2)
  finalPriceSnapshot Decimal                   @map("final_price_snapshot") @db.Decimal(12, 2)
  status             SubscriptionStatus        @default(ACTIVE)
  startDate          DateTime                  @map("start_date") @db.Timestamptz
  endDate            DateTime?                 @map("end_date") @db.Timestamptz
  nextBillingDate    DateTime?                 @map("next_billing_date") @db.Timestamptz
  autoRenew          Boolean                   @default(false) @map("auto_renew")
  paymentStatus      SubscriptionPaymentStatus @default(PAID) @map("payment_status")
  paymentProvider    SubscriptionPaymentProvider @default(MANUAL) @map("payment_provider")
  providerPaymentId  String?                   @map("provider_payment_id")
  providerOrderId    String?                   @map("provider_order_id")
  remarks            String?
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  school   School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments SubscriptionPayment[]

  @@index([schoolId])
  @@index([planId])
  @@index([status, endDate])
  @@index([schoolId, status])
  @@map("school_subscriptions")
}

model SubscriptionPayment {
  id                String                      @id @default(uuid()) @db.Uuid
  schoolId          String                      @map("school_id") @db.Uuid
  subscriptionId    String?                     @map("subscription_id") @db.Uuid
  planId            String                      @map("plan_id") @db.Uuid
  amount            Decimal                     @db.Decimal(12, 2)
  currency          String                      @default("INR")
  paymentMethod     SubscriptionPaymentMethod   @map("payment_method")
  status            SubscriptionPaymentStatus   @default(PENDING)
  referenceNumber   String?                     @map("reference_number")
  provider          SubscriptionPaymentProvider @default(MANUAL)
  providerPaymentId String?                     @map("provider_payment_id")
  providerOrderId   String?                     @map("provider_order_id")
  rejectionReason   String?                     @map("rejection_reason")
  remarks           String?
  requestedAt       DateTime                    @default(now()) @map("requested_at") @db.Timestamptz
  approvedAt        DateTime?                   @map("approved_at") @db.Timestamptz
  approvedById      String?                     @map("approved_by_id") @db.Uuid
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription SchoolSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("SubscriptionPaymentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([subscriptionId])
  @@index([planId])
  @@map("subscription_payments")
}

// ==========================================
// HOSTEL MANAGEMENT MODULE
// ==========================================

model Hostel {
  id          String           @id @default(uuid()) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  name        String
  code        String?
  type        HostelGenderType @default(COMBINED)
  description String?
  address     String?
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms            HostelRoom[]
  beds             HostelBed[]
  enrollments      HostelEnrollment[]
  feeConfigs       HostelFeeConfig[]
  transferFromLogs HostelTransferHistory[] @relation("TransferFromHostel")
  transferToLogs   HostelTransferHistory[] @relation("TransferToHostel")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("hostels")
}

model HostelRoom {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  hostelId   String   @map("hostel_id") @db.Uuid
  roomNumber String   @map("room_number")
  floor      String?
  capacity   Int      @default(1)
  roomType   String?  @map("room_type")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostel           Hostel                  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  beds             HostelBed[]
  enrollments      HostelEnrollment[]
  transferFromLogs HostelTransferHistory[] @relation("TransferFromRoom")
  transferToLogs   HostelTransferHistory[] @relation("TransferToRoom")

  @@unique([hostelId, roomNumber])
  @@index([schoolId])
  @@index([hostelId])
  @@map("hostel_rooms")
}

model HostelBed {
  id        String          @id @default(uuid()) @db.Uuid
  schoolId  String          @map("school_id") @db.Uuid
  hostelId  String          @map("hostel_id") @db.Uuid
  roomId    String          @map("room_id") @db.Uuid
  bedNumber String          @map("bed_number")
  status    HostelBedStatus @default(AVAILABLE)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostel           Hostel                  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room             HostelRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  enrollments      HostelEnrollment[]
  transferFromLogs HostelTransferHistory[] @relation("TransferFromBed")
  transferToLogs   HostelTransferHistory[] @relation("TransferToBed")

  @@unique([roomId, bedNumber])
  @@index([schoolId])
  @@index([hostelId])
  @@index([roomId])
  @@index([schoolId, status])
  @@map("hostel_beds")
}

model HostelEnrollment {
  id             String                 @id @default(uuid()) @db.Uuid
  schoolId       String                 @map("school_id") @db.Uuid
  academicYearId String                 @map("academic_year_id") @db.Uuid
  studentId      String                 @map("student_id") @db.Uuid
  hostelId       String                 @map("hostel_id") @db.Uuid
  roomId         String                 @map("room_id") @db.Uuid
  bedId          String                 @map("bed_id") @db.Uuid
  startDate      DateTime               @map("start_date") @db.Date
  endDate        DateTime?              @map("end_date") @db.Date
  exitReason     String?                @map("exit_reason")
  status         HostelEnrollmentStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  school       School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear            @relation(fields: [academicYearId], references: [id])
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel       Hostel                  @relation(fields: [hostelId], references: [id])
  room         HostelRoom              @relation(fields: [roomId], references: [id])
  bed          HostelBed               @relation(fields: [bedId], references: [id])
  transfers    HostelTransferHistory[]

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([hostelId])
  @@index([roomId])
  @@index([bedId])
  @@index([schoolId, status])
  @@map("hostel_enrollments")
}

model HostelTransferHistory {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  fromHostelId String   @map("from_hostel_id") @db.Uuid
  fromRoomId   String   @map("from_room_id") @db.Uuid
  fromBedId    String   @map("from_bed_id") @db.Uuid
  toHostelId   String   @map("to_hostel_id") @db.Uuid
  toRoomId     String   @map("to_room_id") @db.Uuid
  toBedId      String   @map("to_bed_id") @db.Uuid
  transferDate DateTime @default(now()) @map("transfer_date") @db.Timestamptz
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment HostelEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  fromHostel Hostel           @relation("TransferFromHostel", fields: [fromHostelId], references: [id])
  fromRoom   HostelRoom       @relation("TransferFromRoom", fields: [fromRoomId], references: [id])
  fromBed    HostelBed        @relation("TransferFromBed", fields: [fromBedId], references: [id])
  toHostel   Hostel           @relation("TransferToHostel", fields: [toHostelId], references: [id])
  toRoom     HostelRoom       @relation("TransferToRoom", fields: [toRoomId], references: [id])
  toBed      HostelBed        @relation("TransferToBed", fields: [toBedId], references: [id])

  @@index([schoolId])
  @@index([enrollmentId])
  @@map("hostel_transfer_histories")
}

model HostelFeeConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  schoolId            String   @map("school_id") @db.Uuid
  academicYearId      String   @map("academic_year_id") @db.Uuid
  hostelId            String?  @map("hostel_id") @db.Uuid
  admissionFeeEnabled Boolean  @default(false) @map("admission_fee_enabled")
  admissionFeeAmount  Decimal  @default(0) @map("admission_fee_amount") @db.Decimal(12, 2)
  monthlyFeeEnabled   Boolean  @default(false) @map("monthly_fee_enabled")
  monthlyFeeAmount    Decimal  @default(0) @map("monthly_fee_amount") @db.Decimal(12, 2)
  admissionFeeTypeId  String?  @map("admission_fee_type_id") @db.Uuid
  monthlyFeeTypeId    String?  @map("monthly_fee_type_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  hostel           Hostel?      @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  admissionFeeType FeeType?     @relation("AdmissionFeeConfigType", fields: [admissionFeeTypeId], references: [id], onDelete: SetNull)
  monthlyFeeType   FeeType?     @relation("MonthlyFeeConfigType", fields: [monthlyFeeTypeId], references: [id], onDelete: SetNull)

  @@unique([schoolId, academicYearId, hostelId])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("hostel_fee_configs")
}



