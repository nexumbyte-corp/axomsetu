// Prisma schema for Multi-Tenant School SaaS Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
}

enum SchoolUserRole {
  OWNER
  SCHOOL_ADMIN
  STAFF
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  LEFT
  GRADUATED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATED
  LEFT
}

// DEPRECATED (Legacy Hostel Implementation — preserved for historical data compatibility)
enum HostelStatus {
  ACTIVE
  LEFT
}

enum HostelGenderType {
  BOYS
  GIRLS
  COMBINED
}

enum HostelBedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  BLOCKED
}

enum HostelEnrollmentStatus {
  ACTIVE
  TRANSFERRED
  EXITED
}


enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ChargeStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
  VOID
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  DEMAND_DRAFT
  OTHER
}

enum FinancialTransactionType {
  CREDIT
  DEBIT
}

enum FinancialSourceType {
  FEE_COLLECTION
  FUND_ADDED
  SALARY_PAYMENT
  EXPENSE
  STAFF_ADVANCE
  ADVANCE_RECOVERY
  FEE_REFUND
  OPENING_BALANCE
  OTHER
}

enum FeePaymentStatus {
  SUCCESS
  VOID
}

enum PaymentMethod {
  CASH
  UPI
  BANK
  CARD
  OTHER
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum FeeMonth {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

enum GenerationMode {
  ENTIRE_SCHOOL
  BY_CLASS
  BY_STUDENT
}

enum FeeCategory {
  ACADEMIC
  HOSTEL
}

enum FeeBillingRule {
  ONE_TIME_PER_ACADEMIC_YEAR
  MONTHLY
}

enum FeeTypeSystemCode {
  ADMISSION
  TUITION
  HOSTEL
  HOSTEL_ADMISSION
  MISC
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  ON_LEAVE
}

enum StaffRole {
  TEACHER
  ADMINISTRATOR
  ACCOUNTANT
  LIBRARIAN
  DRIVER
  SUPPORT_STAFF
  OTHER
}

// ==========================================
// PLATFORM & USERS
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  role         Role     @default(SCHOOL_ADMIN)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  schoolAdmins                SchoolAdmin[]
  receivedPayments            FeePayment[]                  @relation("FeePaymentReceivedBy")
  createdExpenses             Expense[]                     @relation("ExpenseCreatedBy")
  createdFeeGenerationBatches FeeGenerationBatch[]          @relation("FeeGenerationBatchCreatedBy")
  createdSalaryPayments       SalaryPayment[]               @relation("SalaryPaymentCreatedBy")
  createdFinancialTxns        FinancialTransaction[]        @relation("FinancialTxnCreatedBy")
  createdFundTransactions     FundTransaction[]             @relation("FundTxnCreatedBy")
  approvedSubscriptionPayments SubscriptionPayment[]        @relation("SubscriptionPaymentApprovedBy")
  overriddenFeeCharges        StudentFeeCharge[]           @relation("FeeChargeOverriddenBy")
  auditLogs                   AuditLog[]
  sessions                    UserSession[]

  @@map("users")
}

model School {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  code      String       @unique
  address   String?
  phone     String?
  email     String?
  logoUrl       String?      @map("logo_url")
  district      String?      @map("district")
  state         String?      @map("state")
  pincode       String?      @map("pincode")
  udiseCode     String?      @map("udise_code")
  affiliationNo String?      @map("affiliation_no")
  website       String?      @map("website")
  status        SchoolStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  admins               SchoolAdmin[]
  academicYears        AcademicYear[]
  classes              Class[]
  sections             Section[]
  mediums              Medium[]
  streams              Stream[]
  students             Student[]
  studentEnrollments   StudentEnrollment[]
  hostelEnrollments    StudentHostelEnrollment[]
  hostels              Hostel[]
  hostelRooms          HostelRoom[]
  hostelBeds           HostelBed[]
  activeHostelEnrollments HostelEnrollment[]
  hostelTransferHistories HostelTransferHistory[]
  hostelFeeConfigs     HostelFeeConfig[]
  feeTypes             FeeType[]
  feeStructures        FeeStructure[]
  studentFeeOverrides  StudentFeeOverride[]
  feeGenerationBatches FeeGenerationBatch[]
  feeCharges           StudentFeeCharge[]
  feePayments          FeePayment[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  fundSources          FundSource[]
  fundTransactions     FundTransaction[]
  financialTxns        FinancialTransaction[]
  staff                Staff[]
  staffAdvances        StaffAdvance[]
  salaryPayments       SalaryPayment[]
  salarySetups         StaffSalarySetup[]
  monthlyPayrolls      MonthlyPayroll[]
  documentSequences    DocumentSequence[]
  subscriptions        SchoolSubscription[]
  subscriptionPayments SubscriptionPayment[]
  auditLogs            AuditLog[]
  sessions             UserSession[]

  @@map("schools")
}

model SchoolAdmin {
  id         String         @id @default(uuid()) @db.Uuid
  schoolId   String         @map("school_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  isOwner    Boolean        @default(false) @map("is_owner")
  schoolRole SchoolUserRole @default(SCHOOL_ADMIN) @map("school_role")
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions SchoolUserPermission[]

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@map("school_admins")
}

model SchoolUserPermission {
  id            String      @id @default(uuid()) @db.Uuid
  schoolAdminId String      @map("school_admin_id") @db.Uuid
  permission    String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  schoolAdmin SchoolAdmin @relation(fields: [schoolAdminId], references: [id], onDelete: Cascade)

  @@unique([schoolAdminId, permission])
  @@index([schoolAdminId])
  @@map("school_user_permissions")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  schoolId         String?   @map("school_id") @db.Uuid
  sessionTokenHash String    @map("session_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionTokenHash])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("user_sessions")
}

// ==========================================
// ACADEMIC STRUCTURE
// ==========================================

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  isLocked  Boolean  @default(false) @map("is_locked")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school               School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments          StudentEnrollment[]
  hostelEnrollments    StudentHostelEnrollment[]
  activeHostelEnrollments HostelEnrollment[]
  hostelFeeConfigs     HostelFeeConfig[]
  feeStructures        FeeStructure[]
  studentFeeOverrides  StudentFeeOverride[]
  feeGenerationBatches FeeGenerationBatch[]
  feeCharges           StudentFeeCharge[]
  feePayments          FeePayment[]
  expenses             Expense[]
  fundTransactions     FundTransaction[]
  financialTxns        FinancialTransaction[]
  salaryPayments       SalaryPayment[]
  salarySetups         StaffSalarySetup[]
  monthlyPayrolls      MonthlyPayroll[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model Class {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  code      String?
  order     Int      @default(0)
  hasStream Boolean  @default(false) @map("has_stream")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments          StudentEnrollment[]
  feeStructures        FeeStructure[]
  feeGenerationBatches FeeGenerationBatch[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments          StudentEnrollment[]
  feeGenerationBatches FeeGenerationBatch[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("sections")
}

model Medium {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments          StudentEnrollment[]
  feeStructures        FeeStructure[]
  feeGenerationBatches FeeGenerationBatch[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("mediums")
}

model Stream {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments          StudentEnrollment[]
  feeStructures        FeeStructure[]
  feeGenerationBatches FeeGenerationBatch[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("streams")
}

// ==========================================
// STUDENTS & ENROLLMENT
// ==========================================

model Student {
  id           String        @id @default(uuid()) @db.Uuid
  schoolId     String        @map("school_id") @db.Uuid
  admissionNo  String        @map("admission_no")
  name         String
  guardianName String        @map("guardian_name")
  phone        String?
  address      String?
  photoUrl     String?       @map("photo_url")
  gender       String?
  caste        String?
  status       StudentStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  school               School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments          StudentEnrollment[]
  hostelEnrollments    StudentHostelEnrollment[]
  activeHostelEnrollments HostelEnrollment[]
  studentFeeOverrides  StudentFeeOverride[]
  feeGenerationBatches FeeGenerationBatch[]
  feeCharges           StudentFeeCharge[]
  feePayments          FeePayment[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, name])
  @@map("students")
}

model StudentEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  sectionId      String?          @map("section_id") @db.Uuid
  mediumId       String           @map("medium_id") @db.Uuid
  streamId       String?          @map("stream_id") @db.Uuid
  rollNo         Int?             @map("roll_no")
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  school            School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student           Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear              @relation(fields: [academicYearId], references: [id])
  class             Class                     @relation(fields: [classId], references: [id])
  section           Section?                  @relation(fields: [sectionId], references: [id])
  medium            Medium                    @relation(fields: [mediumId], references: [id])
  stream            Stream?                   @relation(fields: [streamId], references: [id])
  hostelEnrollments StudentHostelEnrollment[]
  feeCharges        StudentFeeCharge[]

  @@unique([schoolId, academicYearId, studentId])
  @@unique([schoolId, academicYearId, classId, sectionId, rollNo])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([schoolId, academicYearId, classId, sectionId])
  @@index([schoolId, status])
  @@map("student_enrollments")
}

// DEPRECATED (Legacy Hostel Model — preserved for historical data compatibility)
model StudentHostelEnrollment {
  id                  String       @id @default(uuid()) @db.Uuid
  schoolId            String       @map("school_id") @db.Uuid
  academicYearId      String       @map("academic_year_id") @db.Uuid
  studentId           String       @map("student_id") @db.Uuid
  studentEnrollmentId String       @map("student_enrollment_id") @db.Uuid
  startDate           DateTime     @map("start_date") @db.Date
  monthlyStartDate    DateTime?    @map("monthly_start_date") @db.Date
  endDate             DateTime?    @map("end_date") @db.Date
  monthlyHostelFee    Decimal      @map("monthly_hostel_fee") @db.Decimal(12, 2)
  status              HostelStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id])
  student           Student           @relation(fields: [studentId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@map("student_hostel_enrollments")
}

// ==========================================
// FEE MANAGEMENT & RECEIPTS
// ==========================================

model FeeType {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @map("school_id") @db.Uuid
  name        String
  code        String?
  description String?
  order       Int                @default(0)
  category    FeeCategory        @default(ACADEMIC)
  billingRule FeeBillingRule     @default(MONTHLY) @map("billing_rule")
  isActive    Boolean            @default(true) @map("is_active")
  isSystem    Boolean            @default(false) @map("is_system")
  systemCode  FeeTypeSystemCode? @map("system_code")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructureHeads   FeeStructureHead[]
  studentFeeOverrides StudentFeeOverride[]
  feeCharges          StudentFeeCharge[]
  admissionFeeConfigs HostelFeeConfig[]    @relation("AdmissionFeeConfigType")
  monthlyFeeConfigs   HostelFeeConfig[]    @relation("MonthlyFeeConfigType")

  @@unique([schoolId, name])
  @@unique([schoolId, systemCode])
  @@index([schoolId])
  @@map("fee_types")
}

model FeeStructure {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  mediumId       String   @map("medium_id") @db.Uuid
  streamId       String?  @map("stream_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  class             Class              @relation(fields: [classId], references: [id])
  medium            Medium             @relation(fields: [mediumId], references: [id])
  stream            Stream?            @relation(fields: [streamId], references: [id])
  heads             FeeStructureHead[]
  studentFeeCharges StudentFeeCharge[]

  @@unique([schoolId, academicYearId, classId, mediumId, streamId])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("fee_structures")
}

model FeeStructureHead {
  id             String   @id @default(uuid()) @db.Uuid
  feeStructureId String   @map("fee_structure_id") @db.Uuid
  feeTypeId      String   @map("fee_type_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeType      FeeType      @relation(fields: [feeTypeId], references: [id])

  @@unique([feeStructureId, feeTypeId])
  @@index([feeStructureId])
  @@index([feeTypeId])
  @@map("fee_structure_heads")
}

model StudentFeeOverride {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  feeTypeId      String   @map("fee_type_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  feeType      FeeType      @relation(fields: [feeTypeId], references: [id])

  @@unique([schoolId, studentId, academicYearId, feeTypeId])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@map("student_fee_overrides")
}

model FeeGenerationBatch {
  id             String         @id @default(uuid()) @db.Uuid
  schoolId       String         @map("school_id") @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  month          FeeMonth
  mode           GenerationMode
  classId        String?        @map("class_id") @db.Uuid
  mediumId       String?        @map("medium_id") @db.Uuid
  streamId       String?        @map("stream_id") @db.Uuid
  sectionId      String?        @map("section_id") @db.Uuid
  studentId      String?        @map("student_id") @db.Uuid
  totalStudents  Int            @default(0) @map("total_students")
  generatedCount Int            @default(0) @map("generated_count")
  skippedCount   Int            @default(0) @map("skipped_count")
  totalAmount    Decimal        @db.Decimal(12, 2)
  details        Json?
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id])
  class        Class?             @relation(fields: [classId], references: [id])
  medium       Medium?            @relation(fields: [mediumId], references: [id])
  stream       Stream?            @relation(fields: [streamId], references: [id])
  section      Section?           @relation(fields: [sectionId], references: [id])
  student      Student?           @relation(fields: [studentId], references: [id])
  createdBy    User?              @relation("FeeGenerationBatchCreatedBy", fields: [createdById], references: [id])
  charges      StudentFeeCharge[]

  @@index([schoolId])
  @@index([academicYearId])
  @@map("fee_generation_batches")
}

model StudentFeeCharge {
  id                  String       @id @default(uuid()) @db.Uuid
  schoolId            String       @map("school_id") @db.Uuid
  academicYearId      String       @map("academic_year_id") @db.Uuid
  studentId           String       @map("student_id") @db.Uuid
  studentEnrollmentId String?      @map("student_enrollment_id") @db.Uuid
  feeTypeId           String       @map("fee_type_id") @db.Uuid
  feeStructureId      String?      @map("fee_structure_id") @db.Uuid
  generationBatchId   String?      @map("generation_batch_id") @db.Uuid
  month               FeeMonth
  title               String
  amount              Decimal      @db.Decimal(12, 2)
  originalAmount      Decimal?     @map("original_amount") @db.Decimal(12, 2)
  discountAmount      Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  isOverridden        Boolean      @default(false) @map("is_overridden")
  overrideReason      String?      @map("override_reason")
  overriddenById      String?      @map("overridden_by_id") @db.Uuid
  overriddenAt        DateTime?    @map("overridden_at") @db.Timestamptz
  paidAmount          Decimal      @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueDate             DateTime?    @map("due_date") @db.Date
  status              ChargeStatus @default(UNPAID)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear        @relation(fields: [academicYearId], references: [id])
  student           Student             @relation(fields: [studentId], references: [id])
  studentEnrollment StudentEnrollment?  @relation(fields: [studentEnrollmentId], references: [id])
  feeType           FeeType             @relation(fields: [feeTypeId], references: [id])
  feeStructure      FeeStructure?       @relation(fields: [feeStructureId], references: [id])
  generationBatch   FeeGenerationBatch? @relation(fields: [generationBatchId], references: [id], onDelete: SetNull)
  overriddenBy      User?               @relation("FeeChargeOverriddenBy", fields: [overriddenById], references: [id], onDelete: SetNull)
  allocations       PaymentAllocation[]

  @@unique([schoolId, academicYearId, studentEnrollmentId, feeTypeId, title, month])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([generationBatchId])
  @@index([schoolId, studentId, status])
  @@index([schoolId, academicYearId, month, status])
  @@index([schoolId, status, dueDate])
  @@map("student_fee_charges")
}

model FeePayment {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  receiptNumber  String           @map("receipt_number")
  paymentDate    DateTime         @map("payment_date") @db.Timestamptz
  paymentMode    PaymentMode      @map("payment_mode")
  referenceNumber String?         @map("reference_number")
  receivedAmount Decimal          @map("received_amount") @db.Decimal(12, 2)
  remarks        String?
  receivedById   String?          @map("received_by_id") @db.Uuid
  status         FeePaymentStatus @default(SUCCESS)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  student      Student             @relation(fields: [studentId], references: [id])
  receivedBy   User?               @relation("FeePaymentReceivedBy", fields: [receivedById], references: [id])
  allocations  PaymentAllocation[]

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([receiptNumber])
  @@index([paymentDate])
  @@index([schoolId, paymentDate])
  @@index([schoolId, studentId])
  @@map("fee_payments")
}

model PaymentAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  chargeId        String   @map("charge_id") @db.Uuid
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment FeePayment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  StudentFeeCharge @relation(fields: [chargeId], references: [id])

  @@index([paymentId])
  @@index([chargeId])
  @@map("payment_allocations")
}



// ==========================================
