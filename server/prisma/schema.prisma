  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  createdBy    User?         @relation("FinancialTxnCreatedBy", fields: [createdById], references: [id])

  @@index([schoolId])
  @@index([schoolId, transactionDate])
  @@index([schoolId, type])
  @@index([schoolId, sourceType])
  @@index([schoolId, sourceId])
  @@index([schoolId, academicYearId, transactionDate])
  @@index([schoolId, sourceType, sourceId])
